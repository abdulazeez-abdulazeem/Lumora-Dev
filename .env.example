# OpenRouter configuration
PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL=cohere/north-mini-code:free

# Network bind (default localhost). Use 0.0.0.0 in Docker / cloud.
LUMORA_BIND=127.0.0.1

# Cloud platforms often set PORT automatically (FastAPI listen port).
# PORT=8000

# Optional local password gate (set via POST /auth/set-password)
# LUMORA_PASSWORD=
