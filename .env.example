PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL=cohere/north-mini-code:free

# Cloud/Docker: 0.0.0.0  |  Local lockdown: 127.0.0.1
LUMORA_BIND=0.0.0.0

# Public API port (cloud platforms inject PORT)
# PORT=8000

# Optional UI proxy (local only)
# LUMORA_FRONTEND_PORT=5000
# LUMORA_API_PORT=8000
